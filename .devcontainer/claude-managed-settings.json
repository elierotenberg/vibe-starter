{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "requiredMinimumVersion": "2.1.216",
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "allowedMcpServers": [],
  "autoMemoryEnabled": false,
  "browserExternalPageTools": "disabled",
  "channelsEnabled": false,
  "disableAllHooks": true,
  "disableArtifact": true,
  "disableBrowserExternalNavigation": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": ["WebFetch", "WebSearch"],
    "deny": [
      "Read(/.agent-state/**)",
      "Edit(/.agent-state/**)",
      "Write(/.agent-state/**)",
      "Read(//home/node/.claude/**)",
      "Edit(//home/node/.claude/**)",
      "Write(//home/node/.claude/**)",
      "Read(//home/node/.claude.json)",
      "Edit(//home/node/.claude.json)",
      "Write(//home/node/.claude.json)",
      "Read(//home/node/.codex/**)",
      "Edit(//home/node/.codex/**)",
      "Write(//home/node/.codex/**)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(//home/node/.ssh/**)",
      "Read(//home/node/.npmrc)",
      "Edit(/.devcontainer/**)",
      "Write(/.devcontainer/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Edit(/.codex/**)",
      "Write(/.codex/**)",
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)",
      "Edit(/.git/config)",
      "Write(/.git/config)",
      "Edit(/.git/hooks/**)",
      "Write(/.git/hooks/**)",
      "Edit(//.git/config)",
      "Write(//.git/config)",
      "Edit(//.git/hooks/**)",
      "Write(//.git/hooks/**)",
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)",
      "Edit(/compose.yaml)",
      "Write(/compose.yaml)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "allowRead": ["/workspace", "/.git", "/.worktrees", "/home/node/.config"],
      "allowWrite": ["/workspace", "/.git", "/.worktrees", "/home/node/.config"],
      "allowManagedReadPathsOnly": true,
      "denyRead": [
        "/workspace/.agent-state",
        "/home/node/.claude",
        "/home/node/.codex",
        "/home/node/.ssh",
        "/home/node/.npmrc"
      ],
      "denyWrite": [
        "/workspace/.agent-state",
        "/workspace/.devcontainer",
        "/workspace/.claude",
        "/workspace/.codex",
        "/workspace/.github/workflows",
        "/workspace/CLAUDE.md",
        "/workspace/compose.yaml",
        "/home/node",
        "/etc",
        "/root",
        "/run"
      ]
    },
    "credentials": {
      "files": [
        { "path": "/home/node/.claude", "mode": "deny" },
        { "path": "/home/node/.codex", "mode": "deny" },
        { "path": "/home/node/.ssh", "mode": "deny" },
        { "path": "/home/node/.npmrc", "mode": "deny" }
      ],
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "127.0.0.1",
        "api.github.com",
        "codeload.github.com",
        "github.com",
        "localhost",
        "npm.pkg.github.com",
        "objects.githubusercontent.com",
        "postgres",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "release-assets.githubusercontent.com",
        "uploads.github.com"
      ],
      "allowManagedDomainsOnly": true,
      "deniedDomains": [],
      "allowUnixSockets": [],
      "allowLocalBinding": true
    }
  },
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SKIP_PROMPT_HISTORY": "1",
    "DISABLE_AUTOUPDATER": "1"
  }
}
